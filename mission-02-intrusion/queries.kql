// Mission 02 — Your First Intrusion: KQL Queries
// Machine: WKS-L57.hamilton.corp
// Workspace: log-sentinel-lab
// Attack window: 2026-10-12T00:00:00Z – 2026-10-12T23:59:00Z UTC
// Attacker account: helpdesk | Source IP: 10.50.0.100

// ============================================================================
// PART 1 — WARM-UP: My Own labuser Footprint
// ============================================================================

// Query 1: All labuser events in the last 24 hours
SecurityEvent
| where TimeGenerated > ago(24h)
| where TargetUserName == "labuser"
| project TimeGenerated, Account, IpAddress, EventID, Activity

// ---- Results: labuser events visible with source IP 10.50.0.1 ----

// Query 2: Count of failed vs successful labuser logons by IP
SecurityEvent
| where TimeGenerated > ago(24h)
| where TargetUserName == "labuser"
| where EventID in (4624, 4625)
| summarize Attempts = count() by EventID, IpAddress
| sort by Attempts desc

// ---- Results: 3x 4625 (failed), 2x 4624 (success — LogonType 3 + 10) ----

// Query 3: labuser logon story in time order
SecurityEvent
| where TimeGenerated > ago(24h)
| where TargetUserName == "labuser"
| where EventID in (4624, 4625)
| sort by TimeGenerated asc
| project TimeGenerated, EventID, IpAddress, LogonType

// ---- Key observation: one RDP login produces two 4624 events ----
// ---- LogonType 3 (network auth) then LogonType 10 (desktop session) ----

// Query 4: Full details of labuser successful logon
SecurityEvent
| where TimeGenerated > ago(24h)
| where TargetUserName == "labuser"
| where EventID == 4624

// ============================================================================
// PART 2 — HUNT: Real Intrusion Authentication Story
// ============================================================================

// Query 5: Broad sweep — all logon events in attack window, excluding my IP
SecurityEvent
| where TimeGenerated between (datetime(2026-10-12T00:00:00Z) .. datetime(2026-10-12T23:59:00Z))
| where Computer == "WKS-L57.hamilton.corp"
| where EventID in (4624, 4625)
| where IpAddress != "10.50.0.1"   // filter out madumathi's own IP
| summarize Count = count() by EventID, TargetUserName, IpAddress
| sort by Count desc

// ---- Results: helpdesk account, 10.50.0.100, 8 failures + 1 success ----

// Query 6: Filter out known accounts (system noise)
SecurityEvent
| where TimeGenerated between (datetime(2026-10-12T00:00:00Z) .. datetime(2026-10-12T23:59:00Z))
| where Computer == "WKS-L57.hamilton.corp"
| where EventID in (4624, 4625)
| where TargetUserName !in ("labuser", "madumathi", "")
| where IpAddress != "-"
| summarize Count = count() by EventID, TargetUserName, IpAddress
| sort by Count desc

// Query 7: Brute-force pattern — failures then success in time order
SecurityEvent
| where TimeGenerated between (datetime(2026-10-12T00:00:00Z) .. datetime(2026-10-12T23:59:00Z))
| where Computer == "WKS-L57.hamilton.corp"
| where EventID in (4624, 4625)
| where TargetUserName == "helpdesk"
| sort by TimeGenerated asc
| project TimeGenerated, EventID, IpAddress, LogonType, TargetUserName

// ---- Results: 8x 4625 rapid-fire → 4624 at 12:39:05 UTC ----
// ---- Classic brute-force shape: many failures then success ----

// Query 8: Full details of the successful logon
SecurityEvent
| where TimeGenerated between (datetime(2026-10-12T00:00:00Z) .. datetime(2026-10-12T23:59:00Z))
| where Computer == "WKS-L57.hamilton.corp"
| where EventID == 4624
| where TargetUserName == "helpdesk"
| where LogonType == 10
| project TimeGenerated, TargetUserName, IpAddress, LogonType, TargetLogonId, WorkstationName, LogonProcessName, SubjectUserName

// ---- Results:
//   Time:           2026-10-12T12:39:05.1419784Z
//   TargetUserName: helpdesk
//   IpAddress:      10.50.0.100
//   LogonType:      10 (RemoteInteractive / RDP)
//   TargetLogonId:  0x8413e5d
//   WorkstationName: WKS-L57
//   LogonProcessName: User32
//   SubjectUserName: WKS-L57$ (machine account recorded the logon)
// ----

// ============================================================================
// PART 3 — GAP: Attempt to find attacker's command (default logging)
// ============================================================================

// Query 9: Look for process creation events — returns NO results with default logging
// EventID 4688 = process created (requires Audit Process Creation policy)
SecurityEvent
| where TimeGenerated between (datetime(2026-10-12T00:00:00Z) .. datetime(2026-10-12T23:59:00Z))
| where Computer == "WKS-L57.hamilton.corp"
| where EventID == 4688
| project TimeGenerated, SubjectUserName, NewProcessName, CommandLine, ParentProcessName
| order by TimeGenerated asc

// ---- Result: 0 rows. Audit Process Creation policy not enabled by default. ----
// ---- The SIEM shows the attacker got in, but nothing about what they did. ----

// ============================================================================
// PART 4 — AFTER POLICY CHANGE: Find the command (pending coach replay)
// ============================================================================

// Query 10: Find the new attack window — look for 4688 events that didn't exist before
// Run this first to locate the replay time bucket
SecurityEvent
| where TimeGenerated > ago(2h)
| where Computer == "WKS-L57.hamilton.corp"
| where EventID in (4624, 4625, 4688)
| summarize Count = count() by EventID, bin(TimeGenerated, 5m)
| sort by TimeGenerated desc

// ---- Result: cluster of 4625 → 4624 → 4688 at ~08:33 UTC on 2026-10-13 ----

// Query 11: Full process chain — all 4688 events for helpdesk in replay window
SecurityEvent
| where TimeGenerated > ago(2h)
| where Computer == "WKS-L57.hamilton.corp"
| where EventID == 4688
| where SubjectUserName == "helpdesk"
| project TimeGenerated, SubjectUserName, NewProcessName, CommandLine, ParentProcessName
| order by TimeGenerated asc

// ---- Results (2026-10-13T08:33 UTC):
//   08:33:30 | rdpinit.exe  | rdpinit.exe                              | userinit.exe
//   08:33:37 | rdpshell.exe | rdpshell.exe -2057584248                 | rdpinit.exe
//   08:33:37 | cmd.exe      | "cmd.exe" /c echo HAM{rdp_pwned_seat57}> %USERPROFILE%\Desktop\flag.txt | rdpinit.exe
//   08:33:37 | conhost.exe  | conhost.exe 0xffffffff -ForceV1          | cmd.exe
// ----
// ATTACKER COMMAND: cmd.exe /c echo HAM{rdp_pwned_seat57}> %USERPROFILE%\Desktop\flag.txt
// MITRE: T1059.003 — Windows Command Shell

// ============================================================================
// ALERT RULES — Recommended for production deployment
// ============================================================================

// Alert 1: RDP Brute Force — many failures from same IP in short window
// Severity: High | Run every: 5 min | Lookup: last 15 min
SecurityEvent
| where EventID == 4625
| where LogonType == 10
| summarize FailCount = count() by IpAddress, TargetUserName, Computer, bin(TimeGenerated, 5m)
| where FailCount > 5

// Alert 2: Successful RDP logon after failures from same IP (confirmed brute-force)
// Severity: Critical | Run every: 5 min | Lookup: last 15 min
// Fix: bind failures and success to the same 15-minute window to avoid false positives
//      from unrelated historical failures matching a later success on the same IP
let LookbackWindow = ago(15m);
let Failures =
    SecurityEvent
    | where TimeGenerated > LookbackWindow
    | where EventID == 4625
    | where LogonType == 10
    | summarize FailCount = count(), LastFail = max(TimeGenerated) by IpAddress, TargetUserName, Computer, bin(TimeGenerated, 15m);
SecurityEvent
| where TimeGenerated > LookbackWindow
| where EventID == 4624
| where LogonType == 10
| join kind=inner Failures on IpAddress, TargetUserName, Computer
| where FailCount > 3
| project TimeGenerated, TargetUserName, IpAddress, Computer, FailCount

// Alert 3: Suspicious process run after RDP logon (requires EventID 4688 policy enabled)
// Severity: Medium | Run every: 5 min | Lookup: last 5 min
SecurityEvent
| where EventID == 4688
| where SubjectLogonId != "0x0"
| where NewProcessName !startswith "C:\\Windows\\System32\\"
| project TimeGenerated, SubjectUserName, NewProcessName, CommandLine, Computer