// ============================================================
// Mission 04 — Service account goes rogue: KQL queries
// Workspace: log-sentinel-lab (WKS-L57.hamilton.corp)
// Analyst: Madumathi S
// Sentinel displays UTC. All datetime() values below are UTC.
// Query IDs match the citations in dfir-report.md.
// ============================================================


// ------------------------------------------------------------
// SECTION 1 — Batch logons by svc-app57 (T1078.002)
// A batch logon (LogonType 4) is how a scheduled task signs in.
// ------------------------------------------------------------

// 1a. First and last batch logon, and total count
SecurityEvent
| where TimeGenerated > datetime(2026-11-02T13:00:00Z)
| where Computer has "WKS-L57"
| where TargetUserName == "svc-app57" and EventID == 4624 and LogonType == 4
| summarize Runs = count(), FirstRun = min(TimeGenerated), LastRun = max(TimeGenerated)

// 1b. Batch logons per hour (a 15-minute task shows 4 per hour)
SecurityEvent
| where TimeGenerated > datetime(2026-11-02T13:00:00Z)
| where Computer has "WKS-L57"
| where TargetUserName == "svc-app57" and EventID == 4624
| summarize Logons = count() by bin(TimeGenerated, 1h)
| order by TimeGenerated asc


// ------------------------------------------------------------
// SECTION 2 — Discovery and payload (T1033, T1087.001, T1069.001, T1016, T1074.001)
// ------------------------------------------------------------

// 2a. Commands run in the first minute of the 13:41 UTC window
// Check the count here against the commands listed in the report
SecurityEvent
| where TimeGenerated between (datetime(2026-11-02T13:41:00Z) .. datetime(2026-11-02T13:42:00Z))
| where Computer has "WKS-L57"
| where EventID == 4688
| project TimeGenerated, SubjectUserName, SubjectLogonId, NewProcessName, CommandLine, ParentProcessName
| order by TimeGenerated asc

// 2b. Payload launch (started by the scheduler under the machine account)
SecurityEvent
| where TimeGenerated > datetime(2026-11-02T13:00:00Z)
| where Computer has "WKS-L57"
| where EventID == 4688 and CommandLine has "m4_session_payload"
| project TimeGenerated, SubjectUserName, SubjectLogonId, NewProcessName, CommandLine
| order by TimeGenerated asc

// 2c. Ties the discovery commands to the svc-app57 batch logon
// A process runs in the logon session of the account that created it, so the
// SubjectLogonId of 2a should match the TargetLogonId of the 13:41 batch logon.
let batch_session = SecurityEvent
    | where TimeGenerated between (datetime(2026-11-02T13:41:00Z) .. datetime(2026-11-02T13:41:30Z))
    | where Computer has "WKS-L57"
    | where EventID == 4624 and TargetUserName == "svc-app57" and LogonType == 4
    | project TargetLogonId;
SecurityEvent
| where TimeGenerated between (datetime(2026-11-02T13:41:00Z) .. datetime(2026-11-02T13:42:00Z))
| where Computer has "WKS-L57"
| where EventID == 4688
| where SubjectLogonId in (batch_session)
| project TimeGenerated, SubjectUserName, SubjectLogonId, NewProcessName, CommandLine
| order by TimeGenerated asc


// ------------------------------------------------------------
// SECTION 3 — Scheduled tasks (T1053.005)
// ------------------------------------------------------------

// 3a. Task created (4698) and deleted (4699) on WKS-L57
// EventData holds the TaskName and the account that made the change
SecurityEvent
| where TimeGenerated > datetime(2026-11-02T13:00:00Z)
| where Computer has "WKS-L57"
| where EventID in (4698, 4699)
| project TimeGenerated, EventID, SubjectUserName, EventData
| order by TimeGenerated asc

// 3b. Task updates (4702) that involve the M4 tasks only
// Other 4702 events are baseline Windows maintenance tasks
SecurityEvent
| where TimeGenerated > datetime(2026-11-02T13:00:00Z)
| where Computer has "WKS-L57"
| where EventID == 4702 and EventData has "M4-SvcApp57"
| project TimeGenerated, SubjectUserName, EventData
| order by TimeGenerated asc

// 3c. Persistence task launches (each run writes a line to the log)
SecurityEvent
| where TimeGenerated > datetime(2026-11-02T13:00:00Z)
| where Computer has "WKS-L57"
| where EventID == 4688
| where CommandLine has "m4-persistence-log"
| project TimeGenerated, SubjectUserName, NewProcessName, CommandLine
| order by TimeGenerated asc


// ------------------------------------------------------------
// SECTION 4 — Overview of the incident window
// Counts and first/last times per event ID. Use this to check
// coverage before reading the detail queries above.
// ------------------------------------------------------------

SecurityEvent
| where TimeGenerated > datetime(2026-11-02T13:00:00Z)
| where Computer has "WKS-L57"
| where EventID in (4624, 4688, 4698, 4699, 4702)
| summarize Events = count(), First = min(TimeGenerated), Last = max(TimeGenerated) by EventID


// ------------------------------------------------------------
// SECTION 5 — Containment verification (6 November 2026)
// Times are the ones recorded in the report.
// ------------------------------------------------------------

// 5a. Successful logons after the account was disabled at 10:33:29 UTC
// Result: Logons = 0
let disabled_at = datetime(2026-11-06T10:33:29Z);
SecurityEvent
| where TimeGenerated > disabled_at
| where TargetUserName == "svc-app57" and EventID == 4624
| summarize Logons = count(), LastLogon = max(TimeGenerated)

// 5b. Failed logons after the password reset at 10:33:41 UTC
// Result: no rows. The tasks were removed before the reset, so nothing attempted a logon.
let reset_at = datetime(2026-11-06T10:33:41Z);
SecurityEvent
| where TimeGenerated > reset_at
| where TargetUserName == "svc-app57" and EventID == 4625
| summarize Failures = count(), LastFailure = max(TimeGenerated) by Computer, LogonType


// ------------------------------------------------------------
// SECTION 6 — Other hosts and network (checked 6 November 2026)
// No computer filter, so these cover every host in the workspace.
// ------------------------------------------------------------

// 6a. Scheduled task creation for the M4 tasks, any host
// Result: two events, both on WKS-L57
SecurityEvent
| where TimeGenerated > datetime(2026-11-02T13:00:00Z)
| where EventID == 4698 and EventData has "M4-SvcApp57"
| project TimeGenerated, Computer, SubjectUserName, EventData

// 6b. Logons by svc-app57, any host
// Result: WKS-L57 only
SecurityEvent
| where TimeGenerated > datetime(2026-11-01T00:00:00Z)
| where TargetUserName == "svc-app57" and EventID == 4624
| summarize Logons = count(), First = min(TimeGenerated), Last = max(TimeGenerated) by Computer, LogonType

// 6c. Network-traffic check: which tables mention the customer file or the workstation's address
// Result: Heartbeat only (no firewall or flow logs in this workspace)
search "customers.csv" or "10.50.0.57"
| summarize Events = count() by $table