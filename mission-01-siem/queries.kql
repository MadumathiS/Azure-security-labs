// Mission 01 — Getting Eyes on Your Perimeter: KQL Queries
// All queries executed against Log Analytics workspace: log-sentinel-lab
// Data sources: Heartbeat (agent connectivity), Event (unstructured), SecurityEvent (structured)
// Machine: WKS-L57.hamilton.corp
// Date: October 7-9, 2026

// ============================================================================
// QUERY 1: Verify Agent Connectivity (Heartbeat Check)
// ============================================================================
// Purpose: Confirm that the Azure Monitor Agent is communicating with Log Analytics.
// This is the first diagnostic query for any "no data" problem.
// Result: Shows machine is sending heartbeats, agent is functioning.

Heartbeat
| take 10

---

// ============================================================================
// QUERY 2: Machine Health Status
// ============================================================================
// Purpose: Check when the machine was last seen by Log Analytics.
// Indicates whether the machine is currently online/sending data.
// Result on 10/7/2026: WKS-L57 last seen at 11:54 AM (current at query time).

Heartbeat
| summarize LastSeen = max(TimeGenerated) by Computer

---

// ============================================================================
// QUERY 3: Data Freshness / Ingestion Latency
// ============================================================================
// Purpose: Verify that data is arriving in near-real-time (not delayed).
// Calculates delay between event occurrence and Log Analytics ingestion.
// Result: Data is current, minimal ingestion delay.

Heartbeat
| project TimeGenerated, ingestion_time(), Delay = ingestion_time() - TimeGenerated
| take 20

---

// ============================================================================
// QUERY 4: Event Type Distribution
// ============================================================================
// Purpose: Understand what types of events are being collected.
// Breaks down events by severity level: Critical, Error, Warning.
// Useful for baseline understanding of system health.

Event
| summarize count() by EventLevelName

---

// ============================================================================
// QUERY 5: Security Logon Events (Unstructured - Event Table)
// ============================================================================
// Purpose: Query logon events from the unstructured Event table.
// Event ID 4624 = Successful account logon.
// Note: Data is embedded in RenderedDescription field (requires string parsing).
//
// This query demonstrates data collection from dcr-windowsevents
// (Chain A: generic Windows Event Log collection).
// Result: Logon events returned, but data requires KQL string parsing for analysis.

Event
| where EventLog == "Security" and EventID == 4624
| project TimeGenerated, Computer, RenderedDescription
| order by TimeGenerated desc

---

// ============================================================================
// QUERY 6: Security Logon Events (Structured - SecurityEvent Table)
// ============================================================================
// Purpose: Query logon events from the structured SecurityEvent table.
// Event ID 4624 = Successful account logon.
// Data arrives pre-parsed with dedicated columns: Account, LogonType, IpAddress, etc.
//
// This query demonstrates data collection from dcr-securityevents
// (Chain B: Sentinel-optimized Security event collection).
// Result: Logon events with structured data, ready for Sentinel detection rules.

SecurityEvent
| where EventID == 4624
| project TimeGenerated, Computer, Account, LogonType, IpAddress
| order by TimeGenerated desc

---

// ============================================================================
// QUERY 7: Failed Logon Attempts (Detection Use Case)
// ============================================================================
// Purpose: Detect failed logon attempts (Event ID 4625).
// Useful for identifying brute-force or unauthorized access attempts.
// Data comes from SecurityEvent table (structured).

SecurityEvent
| where EventID == 4625
| project TimeGenerated, Computer, Account, FailureReason, IpAddress
| order by TimeGenerated desc

---

// ============================================================================
// STEP 6 DETECTION QUERIES — Unannounced Intrusion Investigation
// Attack Date: October 9, 2026 | Window: 1:09 PM - 2:07 PM UTC
// ============================================================================

// ============================================================================
// QUERY 8: Broad Event Sweep — Identify Unusual Activity
// ============================================================================
// Purpose: First-pass summary of all event types on WKS-L57 after attack window.
// Run this first when anomalous activity is suspected.
// Result: Identified spikes in EventIDs 5379 (70), 4672 (28), 4799 (19).

SecurityEvent
| where TimeGenerated >= datetime(2026-10-09T13:00:00Z)
| where Computer == "WKS-L57.hamilton.corp"
| summarize Count = count() by EventID
| sort by Count desc

---

// ============================================================================
// QUERY 9: Core Attack Events — Privilege Escalation + Registry
// ============================================================================
// Purpose: Isolate the three critical event types that confirm the intrusion.
// EventID 4672 = Special privileges assigned
// EventID 4799 = Group membership changed
// EventID 5379 = Credential Manager read (registry)
// Result: Critical events in 58-minute window confirmed attack.

SecurityEvent
| where TimeGenerated >= datetime(2026-10-09T13:00:00Z)
| where Computer == "WKS-L57.hamilton.corp"
| where EventID in (4672, 4799, 5379)
| project TimeGenerated, EventID, Account
| order by TimeGenerated asc

---

// ============================================================================
// QUERY 10: Group Membership Changes — Which Groups Were Targeted
// ============================================================================
// Purpose: Show exactly which groups the machine account was added to.
// Result: HAMILTON\WKS-L57$ added to Builtin\Administrators and
//         Builtin\Backup Operators in 4 separate waves (~16 min apart).

SecurityEvent
| where TimeGenerated >= datetime(2026-10-09T13:00:00Z)
| where Computer == "WKS-L57.hamilton.corp"
| where EventID == 4799
| project TimeGenerated, Account, TargetAccount, TargetUserName
| order by TimeGenerated asc

---

// ============================================================================
// QUERY 11: Logon Activity During Attack Window
// ============================================================================
// Purpose: Determine if a human logged in or if attack was automated.
// Result: All logons are LogonType 5 (Service) by NT AUTHORITY\SYSTEM.
//         No interactive human logon — attack was fully automated/scripted.

SecurityEvent
| where TimeGenerated >= datetime(2026-10-09T13:00:00Z)
| where Computer == "WKS-L57.hamilton.corp"
| where EventID in (4624, 4625, 4648)
| project TimeGenerated, EventID, Account, LogonType, IpAddress
| order by TimeGenerated asc

---

// ============================================================================
// QUERY 12: Credential Theft Attempt — Credential Manager Reads
// ============================================================================
// Purpose: Investigate what process PID 2240 was reading from Credential Manager.
// Result: Attempted to read WindowsLive tokens for WKS-L57$ and madumathi accounts.
//         Most reads failed (ReturnCode 3221226021 = Access Denied).
//         virtualapp/didlogical token successfully read for both accounts.

SecurityEvent
| where TimeGenerated >= datetime(2026-10-09T13:00:00Z)
| where Computer == "WKS-L57.hamilton.corp"
| where EventID == 5379
| project TimeGenerated, Account, EventData
| order by TimeGenerated asc

---

// ============================================================================
// QUERY 13: New Account Creation Check
// ============================================================================
// Purpose: Verify no backdoor accounts were created during the attack.
// EventID 4720 = Account created, 4722 = Enabled, 4728/4732 = Group added
// Result: No results — no new accounts planted.

SecurityEvent
| where TimeGenerated >= datetime(2026-10-09T13:00:00Z)
| where Computer == "WKS-L57.hamilton.corp"
| where EventID in (4720, 4722, 4728, 4732)
| project TimeGenerated, EventID, Account, TargetAccount
| order by TimeGenerated asc

---

// ============================================================================
// AUTOMATED ALERT RULES (Queries 14-18)
// Note: Deployment as scheduled analytics rules requires Microsoft Sentinel
// Contributor role. Student account has read-only access — saved as named
// queries in Log Analytics for manual execution.
// Estimated detection time if deployed: under 2 minutes.
// ============================================================================

// ============================================================================
// QUERY 14: Alert — Machine Account Added to Administrators
// ============================================================================
// Severity: High | Run every: 5 min | Lookup: last 5 min

SecurityEvent
| where EventID == 4799
| where TargetAccount contains "Administrators"
| where Account endswith "$"
| project TimeGenerated, Account, TargetAccount, Computer

---

// ============================================================================
// QUERY 15: Alert — Privilege Escalation Spike (>3 in 5 minutes)
// ============================================================================
// Severity: High | Run every: 5 min | Lookup: last 5 min

SecurityEvent
| where EventID == 4672
| where Account == "NT AUTHORITY\\SYSTEM"
| summarize Count = count() by bin(TimeGenerated, 5m), Computer
| where Count > 3

---

// ============================================================================
// QUERY 16: Alert — Account Added to Backup Operators
// ============================================================================
// Severity: Medium | Run every: 5 min | Lookup: last 5 min

SecurityEvent
| where EventID == 4799
| where TargetAccount contains "Backup Operators"
| project TimeGenerated, Account, TargetAccount, Computer

---

// ============================================================================
// QUERY 17: Alert — Credential Manager Bulk Read Burst (>5 in 1 minute)
// ============================================================================
// Severity: High | Run every: 5 min | Lookup: last 5 min

SecurityEvent
| where EventID == 5379
| summarize Count = count() by bin(TimeGenerated, 1m), Computer, Account
| where Count > 5

---

// ============================================================================
// QUERY 18: Alert — Repeated Admin Group Addition (Persistence Pattern)
// ============================================================================
// Severity: Critical | Run every: 15 min | Lookup: last 1 hour

SecurityEvent
| where EventID == 4799
| where TargetAccount contains "Administrators" or TargetAccount contains "Backup Operators"
| summarize Count = count() by Computer, Account, TargetAccount, bin(TimeGenerated, 1h)
| where Count > 2

---

// ============================================================================
// NOTES ON DATA COLLECTION CHAINS
// ============================================================================
//
// Chain A (dcr-windowsevents → Event table):
// - Collects: Application, System event logs
// - Data format: Unstructured text in RenderedDescription field
// - Use case: General IT operations monitoring
//
// Chain B (dcr-securityevents → SecurityEvent table):
// - Collects: Security logs only (via "Windows Security Events via AMA")
// - Data format: Pre-structured columns (Account, LogonType, IpAddress, etc.)
// - Use case: Security operations, Sentinel detection rules
// - Status: Active — used for all Step 6 detection queries

---

